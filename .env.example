# No configuration is needed for `docker compose up`.
# These values are useful only when deliberately overriding the local defaults.
POSTGRES_DB=logalog
POSTGRES_USER=logalog
POSTGRES_PASSWORD=logalog
DATABASE_URL=postgresql://logalog:logalog@localhost:5432/logalog
PORT=8080
AUTH_ENABLED=false
RETENTION_DAYS=30
RETENTION_INTERVAL_MS=60000
RETENTION_BATCH_SIZE=2000
