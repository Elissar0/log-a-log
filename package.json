{
  "name": "log-a-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "engines": {
    "bun": "1.2.22"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "start": "bun dist/index.js",
    "build": "bun run build:api && bun run build:ui",
    "build:api": "bun build src/index.ts --outdir dist --target bun",
    "build:ui": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test test/unit web/test",
    "test:ui": "bun test web/test",
    "test:integration": "bun test test/integration",
    "migrate": "bun src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.17.1",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "1.2.22",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.36.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "^8.2.1"
  }
}
